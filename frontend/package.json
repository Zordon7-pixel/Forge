{
  "name": "forge-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:device-source": "node test/deviceSourceTruth.smoke.mjs",
    "test:truth": "node test/truthConsistency.smoke.mjs",
    "test:health-sync": "node test/healthAutoSync.smoke.mjs",
    "test:live-activity": "node test/liveActivity.smoke.mjs",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:build:ios": "npx cap sync ios",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.2.26",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@garmin/fitsdk": "^21.208.0",
    "@stripe/stripe-react-native": "^0.54.0",
    "axios": "^1.18.1",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-leaflet": "^4.2.1",
    "react-native-health": "^1.19.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10",
    "xcode": {
      "uuid": "^14.0.0"
    }
