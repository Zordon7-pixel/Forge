# Dependencies
node_modules/

# Database files — NEVER commit
*.db
*.db-shm
*.db-wal

# Environment files — NEVER commit
.env
.env.local
.env.development
.env.production
.env.staging
.env*.local
backend/.env
frontend/.env
frontend/credentials.json
frontend/credentials/

# Build artifacts — generated by `vite build` at deploy time
frontend/dist/

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*

# Browser QA artifacts
frontend/playwright-report/
frontend/test-results/

# Local agent usage telemetry
.build-prompts/*-usage.json
